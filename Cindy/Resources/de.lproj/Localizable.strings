/* MARK: - Calibration */
"Calibration" = "Kalibrierung";
"How it works" = "So funktioniert’s";
"Phone flat on the floor under the pull-up bar, screen facing up." = "Handy flach auf den Boden unter die Klimmzugstange, Display nach oben.";
