    <string name="settings_reminder_header">Reminder</string>
    <string name="settings_remind_me">Remind me</string>
    <string name="settings_next_reminder">Next reminder</string>
    <string name="settings_reminder_denied">Notifications are switched off for Cindy. Turn them on in Settings › Apps › Cindy › Notifications.</string>
    <string name="settings_reminder_footer">Cindy picks the moment from how hard the last session was, how you have recovered and when you usually train — and moves it when your body says so. It is scheduled on the device; nothing is sent anywhere.</string>
    <string name="settings_privacy">Privacy</string>
    <string name="settings_privacy_no_recording_title">No video or photo recording</string>
    <string name="settings_privacy_no_recording_body">The camera only runs during calibration and your workout. Every frame is analyzed on the phone right away and then discarded. No photos or videos are stored.</string>
    <string name="settings_privacy_nothing_sent_title">Nothing is sent anywhere</string>
    <string name="settings_privacy_nothing_sent_body">Cindy has no servers, no accounts and never opens an internet connection. Your data only leaves the device if you share it yourself.</string>
    <string name="settings_privacy_local_title">What is stored locally</string>
    <string name="settings_privacy_local_body">Calibration, workout plan and history live in the app\'s storage. They are not part of device backups and are removed when you delete the app.</string>
    <string name="settings_privacy_policy">Privacy policy</string>
