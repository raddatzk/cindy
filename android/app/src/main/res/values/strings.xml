    <!-- Intro -->
    <string name="onboarding_welcome_title">Welcome to Cindy</string>
    <!-- The duration is always 5, 10, 15 or 20 minutes. -->
    <string name="onboarding_welcome_body" tools:ignore="PluralsCandidate">Cindy is a CrossFit benchmark workout: one round is %1$s. You repeat that round as often as you can in %2$d minutes — that is what AMRAP means.</string>
    <string name="onboarding_welcome_score">Your score is rounds plus the reps of the round you did not finish. The plan is yours to change at any time.</string>
    <string name="onboarding_setup_title">Put the phone down once</string>
    <string name="onboarding_setup_stays">It stays there for the whole workout. You never touch it or look at it again.</string>
    <string name="onboarding_setup_beeps">Cindy beeps for every rep, with a higher tone when an exercise is done.</string>
    <string name="onboarding_setup_privacy">Every frame is analyzed on the phone and discarded right away. No photos, no video, no internet connection.</string>
    <string name="onboarding_calibration_title">One calibration first</string>
    <string name="onboarding_calibration_body">Everybody moves differently, so Cindy measures you once: one rep of each exercise, one after another. It takes about two minutes.</string>
    <string name="onboarding_calibration_repeat">Repeat it when you change where the phone lies, or when counting starts to drift.</string>
    <string name="onboarding_calibration_clothes">Train in the clothes you calibrated in, without a cap or hood.</string>
    <string name="onboarding_not_now">Not now</string>
    <string name="onboarding_skip">Skip</string>
    <string name="onboarding_start_calibration">Start calibration</string>
    <string name="onboarding_page">Page %1$d of %2$d</string>

